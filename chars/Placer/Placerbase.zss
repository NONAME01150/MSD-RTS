[Function TileandBGSpawn(anim,x,y,spr,play,xshear,xdelta,ydelta)]

explod{anim: $anim;
space: stage;
pos: camerapos x * $xdelta + $x,camerapos y * $ydelta + $y;
removetime: 1;
sprpriority: $spr;
ownpal: 1;
animplayerno: $play;
spriteplayerno: $play;
xshear: $xshear}

[Function IncreaseNumber() ret]

let ret = 0;

if inputtime(R) = 1
{
	let ret = $ret + 1;
}
if inputtime(L) = 1
{
	let ret = $ret - 1;
}
if inputtime(U) = 1
{
	let ret = $ret + 10;
}
if inputtime(D) = 1
{
	let ret = $ret - 10;
}

[Function Trunc(i) ret]

let ret = 0;

if $i < 0
{
	let ret = ceil($i);
}
else
{
	let ret = floor($i);
}

#st = step, sbst = substep
[Function PlatExtra(l,h,w,st,sbst,flag,yadd)]

map(1) := $l;
map(2) := $h;
map(3) := $w;
map(4) := $st;
map(5) := $sbst;
map(6) := $flag;
map(7) := $yadd;

[Function PlatStart(i,x,y,z)]

let Id = playerid($i),ID;
let PosX = Call Trunc(playerid($i),pos X + playerid($i),cameraPos X);
let PosY = Call Trunc(playerid($i),pos Y + playerid($i),GroundLevel);
let PosZ = Call Trunc(playerid($i),pos Z);
let L = map(1) + 1;
let H = map(2) + 1;
let W = map(3);
let ST = map(4) + map(5) / 256;
let FLAG = map(6);
let VelX = playerid($i),vel X;
let VelY = playerid($i),vel Y;

#let x = $x - min(playerid($i),clsnvar(size, 0, Back),playerid($i),clsnvar(size, 0, Front));

let XDist = ($x - (playerid($i),pos X + playerid($i),cameraPos X)) - 1 * (sign($x) = -1);
let YDist = $y + $H - (playerid($i),pos Y + playerid($i),GroundLevel) + 1;
let ZDist = $z - (playerid($i),pos Z) - 1 * (sign($z) = -1);

let a = cond(sign($H) = -1,$y - $H,$y);
let b = cond(sign($H) != -1,$y + $H,$y);
let c = min(max($ST * ($PosX - $x),0),$H);
let d = max(min($ST * ($PosX - $x),0),-$H);
if sign($ST) = -1
{
	let d = $ST * ($PosX - $x);
	if $d < -$H
	{
		let d = -$H;
	}
	else if $d > 0
	{
		let d = 0;
	}
}
let e = cond(sign($ST) = -1,$d,$c);

map(N115_PenetrateBox) := 0;
if floor($x - (playerid($i),pos X + playerid($i),cameraPos X) + $VelX) = [0,$L]
{
	map(N115_PenetrateBox) := map(N115_PenetrateBox) + 1;
}
if (playerid($i),pos Y + playerid($i),GroundLevel) - $y + $VelY = [0,$H]
{
	map(N115_PenetrateBox) := map(N115_PenetrateBox) + 2;
}

ignorehitpause if $PosX = [$x - abs($VelX),$x + $L + abs($VelX)] && $PosY = [$a - abs($VelY),$b + abs($VelY)] && $PosZ = [$z,$z + $W]
{
	map(N115_PlatFound) := 1;
	if !($FLAG & 1) #|| $FLAG & 1 && abs($y - (playerid($i),pos Y + playerid($i),GroundLevel)) = [0,1 + $VelY]
	{
		GroundLevelOffset{value: $y + $e; redirectID: $Id}
	}
	if $FLAG & 1 #&& $YDist > 1 + abs($VelY)
	{
	if 0
	{
		if $VelY >= 0
		{
			if map(N115_PenetrateBox) & 1
			{
				if abs($XDist) >= $L * 0.5
				{
					let XDist = ($x - (playerid($i),pos X + playerid($i),cameraPos X) + $L) + 1 * (sign($x) != -1);
				}
				posadd{x: $XDist * playerid($i),facing; redirectID: $Id}
			}

			map(N115_PenetrateBox) := 0;
			if floor($x - (playerid($i),pos X + playerid($i),cameraPos X) + $VelX) = [0,$L]
			{
				map(N115_PenetrateBox) := map(N115_PenetrateBox) + 1;
			}
			if (playerid($i),pos Y + playerid($i),GroundLevel) - $y + $VelY = [0,$H]
			{
				map(N115_PenetrateBox) := map(N115_PenetrateBox) + 2;
			}

			if map(N115_PenetrateBox) & 2
			{
				velset{y: max(0,$VelY); redirectID: $Id}
				posadd{y: $YDist; redirectID: $Id}
			}
		}
		else
		{
			if map(N115_PenetrateBox) & 2
			{
				velset{y: max(0,$VelY); redirectID: $Id}
				posadd{y: $YDist; redirectID: $Id}
			}

			map(N115_PenetrateBox) := 0;
			if floor($x - (playerid($i),pos X + playerid($i),cameraPos X) + $VelX) = [0,$L]
			{
				map(N115_PenetrateBox) := map(N115_PenetrateBox) + 1;
			}
			if (playerid($i),pos Y + playerid($i),GroundLevel) - $y + $VelY = [0,$H]
			{
				map(N115_PenetrateBox) := map(N115_PenetrateBox) + 2;
			}

			if map(N115_PenetrateBox) & 1
			{
				if abs($XDist) >= $L * 0.5
				{
					let XDist = ($x - (playerid($i),pos X + playerid($i),cameraPos X) + $L) + 1 * (sign($x) != -1);
				}
				posadd{x: $XDist * playerid($i),facing; redirectID: $Id}
			}
		}
	}

		if $FLAG & 8 #&& $YDist < $H * 0.5
		{
			if abs($XDist) >= $L * 0.5
			{
				let XDist = ($x - (playerid($i),pos X + playerid($i),cameraPos X) + $L) + 1 * (sign($x) != -1);
			}
			posadd{x: $XDist * playerid($i),facing; redirectID: $Id}
		}
		if $FLAG & 16 #$YDist >= $H * 0.5
		{
			velset{y: max(0,$VelY); redirectID: $Id}
			posadd{y: $YDist; redirectID: $Id}
		}
		if $FLAG & 32
		{
			if abs($ZDist) >= $L * 0.5
			{
				let ZDist = ($x - (playerid($i),pos X + playerid($i),cameraPos X) + $L) + 1 * (sign($x) != -1);
			}
			posadd{x: $ZDist * playerid($i),facing; redirectID: $Id}
		}
	}
	if $FLAG & 2 && !($FLAG & 1)
	{
		GroundLevelOffset{value: $y + $H + $e; redirectID: $Id}
	}
	let c = max(abs(playerid($i),vel x),abs(playerid($i),vel z));
	let b = (playerid($i),statetype != A && playerid($i),statetype != L);

	if $FLAG & 4 && abs(playerid($i),pos y) = [0,$c + 1] && $b
	{
		PosSet{y: 0; redirectID: $Id}
	}
}
else
{
	map(N115_PlatFound) := 0;
}

[Function OverrideClsn(i,index,l,u,r,d)]

switch $i
{
	case 0:
	OverrideClsn{group: size;
	index: $index;
	rect: $l,$u,$r,$d}
	case 1:
	OverrideClsn{group: clsn1;
	index: $index;
	rect: $l,$u,$r,$d}
	case 2:
	OverrideClsn{group: clsn2;
	index: $index;
	rect: $l,$u,$r,$d}
}

[StateDef 5900; type: S; Physics: N;]

if ishelper
{
	changeanim{value: -2}
}
if !ishelper
{
	assertspecial{flag: invisible}
}

[StateDef 0; type: S; Physics: N;]

if !ishelper
{
	if facing != 1
	{
		turn{}
	}
	assertspecial{flag: nostandguard;
	flag2: nocrouchguard;
	flag3: noairguard;
	flag4: NoHardCodedKeys;
	flag5: noautoturn;
	flag6: NoAIButtonJam;
	flag7: NoAICheat;
	flag8: SizePushOnly}
	changeanim{value: 0}
	let xvel = 1;
	let yvel = 1;
	let a = (inputtime(R) > 0 && (inputtime(R) = 1 || map(movehold) > 18));
	let b = (inputtime(L) > 0 && (inputtime(L) = 1 || map(movehold) > 18));
	let c = (inputtime(D) > 0 && (inputtime(D) = 1 || map(movehold) > 18));
	let d = (inputtime(U) > 0 && (inputtime(U) = 1 || map(movehold) > 18));
	if inputtime(R) > 0 || inputtime(L) > 0 || inputtime(D) > 0 || inputtime(U) > 0
	{
		map(movehold) := map(movehold) + 1;
	}
	else
	{
		map(movehold) := 0;
	}
	if !map(menu)
	{
		if map(positiontype) = 0 && !map(dontmove)
		{
			posadd{x: $xvel * $a - $xvel * $b;
			y: $yvel * $c - $yvel * $d}
		}
		if (map(positiontype) = 1 && (map(movehold) <= 1 || map(movehold) && map(movehold) % 2 = 0)) && !map(dontmove)
		{
			let e = Pos X + CameraPos X;
			let f = $e / 8;
			let g = floor($f) * 8;
			let h = Pos Y + GroundLevel;
			let i = $h / 8;
			let j = floor($i) * 8;
			if $e < 0
			{
				posadd{x: $e - $g}
			}
			else
			{
				posadd{x: $g - $e}
			}
			if $h < 0
			{
				posadd{y: $h - $j}
			}
			else
			{
				posadd{y: $j - $h}
			}
			posadd{x: 8 * $a - 8 * $b;
			y: 8 * $c - 8 * $d}
		}
		map(dontmove) := 0;
		map(increasechosen) := 0;
		if inputtime(z) = 1 && map(menu) != 2
		{
			map(positiontype) := cond(map(positiontype), 0, 1);
		}
		let inc = call IncreaseNumber();
		if inputtime(x) > 0 && map(menu) != 2
		{
			map(dontmove) := 1;
			map(increasechosen) := 1;
			map(playerchosen) := map(playerchosen) + $inc;
			if map(playerchosen) > 12
			{
				map(playerchosen) := 0;
			}
			if map(playerchosen) < 0
			{
				map(playerchosen) := 12;
			}
		}
		else if inputtime(y) > 0 && map(menu) != 2
		{
			map(dontmove) := 1;
			map(increasechosen) := 1;
			map(animchosen) := map(animchosen) + $inc;
		}
		if inputtime(b) = 1
		{
			switch map(entitychosen)
			{
				case 1:
				for i = 0; 3; 1
				{
					if map(found)
					{
						break;
					}
					for j = 0; 2499; 1
					{
						let a = $i * 11;
						if fvar(0 + $a) <= -1
						{
							fvar(0 + $a) := map(entitychosen);
							fvar(0 + 1 + $a) := pos x + camerapos x;
							fvar(0 + 2 + $a) := pos y + groundlevel;
							fvar(0 + 3 + $a) := pos z;
							fvar(0 + 4 + $a) := map(playerchosen);
							fvar(0 + 5 + $a) := map(animchosen);
							fvar(0 + 6 + $a) := map(sprprioritychosen);
							fvar(0 + 7 + $a) := map(xshearchosen);
							fvar(0 + 8 + $a) := map(xdelta);
							fvar(0 + 9 + $a) := map(ydelta);
							fvar(0 + 10 + $a) := map(active);
							map(found) := 1;
							break;
						}
						else
						{
							continue;
						}
					}
				}
				case 3:
				for i = 0; 799; 1
				{
					let a = $i * 14;
					if var(110012 + $a) <= -1
					{
						var(110012 + $a) := map(entitychosen);
						var(110012 + 1 + $a) := pos x + camerapos x;
						var(110012 + 2 + $a) := pos y + groundlevel;
						var(110012 + 3 + $a) := pos z;
						var(110012 + 4 + $a) := map(width);
						var(110012 + 5 + $a) := map(height);
						var(110012 + 6 + $a) := map(yadd);
						var(110012 + 7 + $a) := map(step);
						var(110012 + 8 + $a) := map(substep);
						var(110012 + 9 + $a) := map(zup);
						var(110012 + 10 + $a) := map(zdown);
						var(110012 + 11 + $a) := map(flag);
						map(found) := 1;
						break;
					}
					else
					{
						continue;
					}
				}
			}
		}
	}
	else
	{
		assertspecial{flag: invisible}
	}
	map(found) := 0;
	if map(entitychosen)
	{
		assertspecial{flag: invisible}
	}
	switch map(menu)
	{
		case 0:
			if inputtime(a) = 1
			{
				map(menu) := map(entitychosen) + 1;
				map(menuchoice) := 1;
			}
			if inputtime(b) = 1
			{
				if map(entitychosen) = 1
				{
					
				}
			}
		case 1:
			map(menuchoice) := map(menuchoice) + 1 * (inputtime(D) = 1) - 1 * (inputtime(U) = 1);
			if map(menuchoice) < 1
			{
				map(menuchoice) := 4;
			}
			if map(menuchoice) > 4
			{
				map(menuchoice) := 1;
			}

			if inputtime(a) = 1
			{
				map(entitychosen) := map(menuchoice);
				map(menu) := map(menuchoice) + 1;
				map(menuchoice) := 1;
			}
			if inputtime(c) = 1
			{
				map(menu) := 0;
				map(menuchoice) := 0;
			}
		case 2:
			map(menuchoice) := map(menuchoice) + 1 * (inputtime(D) = 1) - 1 * (inputtime(U) = 1);
			let inc10 = cond(inputtime(x) > 0, 10, 1);
			let inc100 = cond(inputtime(z) > 0, 100, 1);
			let inc01 = cond(inputtime(x) > 0, 0.1, 0.01);
			let inc001 = cond(inputtime(z) > 0, 1, 0.01);
			if map(menuchoice) < 1
			{
				map(menuchoice) := 8;
			}
			if map(menuchoice) > 8
			{
				map(menuchoice) := 1;
			}
			if map(menuchoice) = 1
			{
				map(playerchosen) := map(playerchosen) + max($inc10,$inc100) * (inputtime(R) = 1) - max($inc10,$inc100) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 2
			{
				map(animchosen) := map(animchosen) + max($inc10,$inc100) * (inputtime(R) = 1) - max($inc10,$inc100) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 3
			{
				map(sprprioritychosen) := map(sprprioritychosen) + max($inc10,$inc100) * (inputtime(R) = 1) - max($inc10,$inc100) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 4
			{
				map(xshearchosen) := map(xshearchosen) + max($inc01,$inc001) * (inputtime(R) = 1) - max($inc01,$inc001) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 5
			{
				map(xdelta) := map(xdelta) + max($inc01,$inc001) * (inputtime(R) = 1) - max($inc01,$inc001) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 6
			{
				map(ydelta) := map(ydelta) + max($inc01,$inc001) * (inputtime(R) = 1) - max($inc01,$inc001) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 7
			{
				if inputtime(R) = 1
				{
					map(active) := 0;
				}
				if inputtime(L) = 1
				{
					map(active) := -1;
				}
			}
			if inputtime(a) = 1
			{
				map(menu) := 0;
				map(menuchoice) := 0;
			}
			if inputtime(c) = 1
			{
				map(menu) := 1;
				map(menuchoice) := 1;
			}
		case 4:
			let a = Call Trunc(map(substep) / 256);
			let a = abs($a);
			map(menuchoice) := map(menuchoice) + 1 * (inputtime(D) = 1) - 1 * (inputtime(U) = 1);
			let inc10 = cond(inputtime(x) > 0, 16, 1);
			let inc100 = cond(inputtime(z) > 0, 64, 1);
			let inc01 = cond(inputtime(x) > 0, 0.1, 0.01);
			let inc001 = cond(inputtime(z) > 0, 1, 0.01);
			let inc10hex = cond(inputtime(x) > 0, 16, 1);
			let inc100hex = cond(inputtime(z) > 0, 256, 1);
			if map(menuchoice) < 1
			{
				map(menuchoice) := 6;
			}
			if map(menuchoice) > 6
			{
				map(menuchoice) := 1;
			}
			if map(menuchoice) = 1
			{
				map(width) := map(width) + max($inc10,$inc100) * (inputtime(R) = 1) - max($inc10,$inc100) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 2
			{
				map(height) := map(height) + max($inc10,$inc100) * (inputtime(R) = 1) - max($inc10,$inc100) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 3
			{
				map(substep) := map(substep) + max($inc10hex,$inc100hex) * (inputtime(R) = 1) - max($inc10hex,$inc100hex) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 4
			{
				map(yadd) := map(yadd) + max($inc10,$inc100) * (inputtime(R) = 1) - max($inc10,$inc100) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 5
			{
				map(zup) := map(zup) + max($inc10,$inc100) * (inputtime(R) = 1) - max($inc10,$inc100) * (inputtime(L) = 1);
			}
			if map(menuchoice) = 6
			{
				map(flag) := map(flag) + 1 * (inputtime(R) = 1) - 1 * (inputtime(L) = 1);
			}

			if map(width) < 0
			{
				map(width) := 0;
			}
			if map(height) < 0
			{
				map(height) := 0;
			}
			if map(yadd) < 0
			{
				map(yadd) := 0;
			}
			if map(zup) < 0
			{
				map(zup) := 0;
			}
			if map(substep) != [0,255]
			{
				map(step) := map(step) + 1 * sign(map(substep));
				map(substep) := map(substep) - 256 * sign(map(substep));
			}
			if 0 #map(substep) <= -1
			{
				map(step) := map(step) - 1;
				map(substep) := map(substep) + 256;
			}
			if 0 #map(substep) >= 256
			{
				map(step) := map(step) + 1;
				map(substep) := map(substep) - 256;
			}
			if map(flag) != [0,255]
			{
				map(flag) := 0;
			}
			if inputtime(a) = 1
			{
				map(menu) := 0;
				map(menuchoice) := 0;
			}
			if inputtime(c) = 1
			{
				map(menu) := 1;
				map(menuchoice) := 1;
			}
		default:
			#if inputtime(a) = 1
			#{
				map(menu) := 0;
				map(menuchoice) := 0;
			#}
	}
	if map(N115_Lead) = ID
	{
		map(N115_Placer_Object_Index) := 0;
		for h = 0; 3; 1
		{
			for i = 0; 2499; 1
			{
				let a = fvar(map(N115_Placer_Object_Index) * 11);
				let b = map(N115_Placer_Object_Index) * 11;
				if $a > -1 && fvar(10 + $b) > -1
				{
					call TileandBGSpawn(fvar(5 + $b), #anim
					fvar(1 + $b),fvar(2 + $b) + fvar(3 + $b), #x,y (y+z pos combined)
					fvar(6 + $b),fvar(4 + $b),fvar(7 + $b), #sprpriority,playerno,xshear
					fvar(8 + $b),fvar(9 + $b)); #xdelta,ydelta
				}
				else
				{
					break;
				}
				map(N115_Placer_Object_Index) := map(N115_Placer_Object_Index) + 1;
			}
		}
		map(N115_Placer_Object_Index) := 0;
	}
	if 0 #map(refresh) paging attempt, wasn't working well or i wasn't coding well. next time i'll make a Streets Of Rage Remake paging style instead
	{
		map(N115_Placer_Object_Index) := 0;
		for i = 0; 3; 1
		{
			for j = 0; 2499; 1
			{
				let a = fvar(map(N115_Placer_Object_Index) * 11);
				let b = map(N115_Placer_Object_Index) * 11;
				#let c = fvar(map(N115_Placer_Object_Index) * 11 + 10);
				if $a > -1
				{
					fvar(2000000 + $b) := fvar(map(N115_Placer_Object_Index) + $b);
					fvar(2000001 + $b) := fvar(map(N115_Placer_Object_Index) + 1 + $b);
					fvar(2000002 + $b) := fvar(map(N115_Placer_Object_Index) + 2 + $b);
					fvar(2000003 + $b) := fvar(map(N115_Placer_Object_Index) + 3 + $b);
					fvar(2000004 + $b) := fvar(map(N115_Placer_Object_Index) + 4 + $b);
					fvar(2000005 + $b) := fvar(map(N115_Placer_Object_Index) + 5 + $b);
					fvar(2000006 + $b) := fvar(map(N115_Placer_Object_Index) + 6 + $b);
					fvar(2000007 + $b) := fvar(map(N115_Placer_Object_Index) + 7 + $b);
					fvar(2000008 + $b) := fvar(map(N115_Placer_Object_Index) + 8 + $b);
					fvar(2000009 + $b) := fvar(map(N115_Placer_Object_Index) + 9 + $b);
					fvar(2000010 + $b) := fvar(map(N115_Placer_Object_Index) + 10 + $b);
				}
				map(N115_Placer_Object_Index) := map(N115_Placer_Object_Index) + 1;
			}
		}
		map(refresh) := 0;
	}
}

[StateDef 3;]

assertspecial{flag: nostandguard;
	flag2: nocrouchguard;
	flag3: noairguard;
	flag4: NoHardCodedKeys;
	flag5: noautoturn;
	flag6: invisible;
	flag7: RunLast;
	flag8: SizePushOnly}

#playerpush{value: 0}

if 0 #pos x + camerapos x >= 0
{
	posadd{x: (pos x + camerapos x) - 0}
}
else
{
	posadd{x: 0 - (pos x + camerapos x)}
}

posset{y: 0; z: 0}

for i = 0; numplayer - 1; 1
{
	map(N115_PlatFound) := 0;
	if playerindexexist($i) && playerindex($i),ID != ID && playerindex($i),ID != Root,ID && !playerindex($i),standby
	{
		map(playergot) := playerindex($i),ID;
		let ID = playerindex($i),ID;
		for j = 0; 799; 1
		{
			let a = $j * 14;
			if root,var(110012 + $a) <= -1 #|| map(N115_PlatFound)
			{
				break;
			}
			else
			{
				Call PlatExtra(root,var(110012 + 4 + $a),root,var(110012 + 5 + $a),root,var(110012 + 9 + $a),root,var(110012 + 7 + $a),root,var(110012 + 8 + $a),root,var(110012 + 11 + $a),var(110012 + 6 + $a));
				Call PlatStart($ID,root,var(110012 + 1 + $a),root,var(110012 + 2 + $a),root,var(110012 + 3 + $a));
			}
			#Call overrideclsn(2,$j,root,var(110012 + 1 + $a),root,var(110012 + 2 + $a),root,var(110012 + 1 + $a) + root,var(110012 + 4 + $a),root,var(110012 + 2 + $a) + root,var(110012 + 5 + $a));
			if DebugMode(wireframedisplay) && floor(abs((root,var(110012 + 1 + $a)) - (camerapos x - 160))) = [0,max(const240p(gamewidth),root,var(110012 + 4 + $a))]
			{
				explod{anim: 2;
				id: 1;
				pos: root,var(110012 + 1 + $a),root,var(110012 + 2 + $a);
				space: stage;
				scale: root,var(110012 + 4 + $a) + 1,root,var(110012 + 5 + $a) + 1;
				removetime: 1;
				ownpal: 1}
			}
		}
	}
	else
	{
		continue;
	}
}

if time && map(N115_playerhelper) != root,map(N115_playerhelper) := 0
{
	destroyself{}
}

map(N115_playerhelper) := root,map(N115_playerhelper);

#[StateDef +1;]

[StateDef -4;]

if !ishelper
{
	playerpush{value: 0}
	if !map(N115_Lead) || !playeridexist(map(N115_Lead))
	{
		map(a) := 0;
		for i = 0; numplayer - 1; 1
		{
			if playerindexexist($i) && !playerindex($i),ishelper && playerindex($i),name = "Placer" && playerindex($i),authorname = "NONAME01150"
			{
				if !map(N115_Lead)
				{
					map(N115_Lead) := playerindex($i),id;
				}
				playerindex($i),map(N115_MemberNo) := map(a) + 1;
				map(a) := map(a) + 1;
			}
		}
	}
	map(N115_playerhelper) := 0;
	for i = 1; 12; 1
	{
		let a = player($i),ID;
		if playeridexist($a)
		{
			map(N115_playerhelper) := map(N115_playerhelper) + playerid($a),numhelper;
		}
	}
	if !numhelper
	{
		helper{helpertype: normal;
		name: "Collision Manager";
		stateno: 3;
		ownpal: 1;
		supermovetime: 2000000;
		pausemovetime: 2000000;
		immortal: 1;
		standby: 1}
	}
}

if roundstate < 2 && id = map(N115_Lead)
{
	for i = 0; 2499; 1
	{
		for j = 0; 10; 1
		{
			fvar(0 + $j + $i * 11) := -1;
		}
	}
	for i = 0; 799; 1
	{
		for j = 0; 13; 1
		{
			var(110012 + $j + $i * 11) := -1;
		}
	}
}