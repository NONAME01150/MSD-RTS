[StateDef 5900; type: S; Physics: N;]

if ishelper
{
	changeanim{value: -2}
}
Call RebelInfantry();
Call AllProjectile();
Call State(0);

[StateDef 0; Physics: N;]

if !ishelper
{
	sprpriority{value: 3000;}
	if roundstate > 0
	{
		TagOut{}
	}
	if !ailevel
	{
		if teamside = 1 && 0
		{
		Camera{view: Follow;
		FollowID: ID;}
		}
		let xvel = 4 - 3 * (inputtime(b) > 0);
		let yvel = 3 - 2.25 * (inputtime(b) > 0);
		Call Anim(0);
		let a = (inputtime(R) > 0);
		let b = (inputtime(R) % 4 = 0) * $a;
		let c = (inputtime(L) > 0);
		let d = (inputtime(L) % 4 = 0) * $c;

		let e = (inputtime(D) > 0);
		let f = (inputtime(D) % 4 = 0) * $e;
		let g = (inputtime(U) > 0);
		let h = (inputtime(U) % 4 = 0) * $g;
		posadd{x: $xvel * $a + -$xvel * $c;
		y: $yvel * $e + -$yvel * $g}
		if facing != 1
		{
			turn{}
		}
		if inputtime(y) = 1
		{
			for i = 0; numplayer - 1; 1
			{
				if playerindex($i),ishelper && playerindex($i),root,id = id && playerindex($i),map(UnitID) > 0
				{
					lifeset{value: 1;
					redirectid: playerindex($i),id}
				}
			}
		}
		map(chosenReinforce) := -1;
		for i = 0; 4; 1
		{
			if playerid(map(LeadRTS)),numexplod(30005 + $i) && screenpos x = [15 * $i, 15 * $i + 14] && screenpos y = [2,2 + 15]   #[2 + 20 * (memberno - 1),2 + 15 + 20 * (memberno - 1)] # Separate Coop Method
			{
				modifyexplod{id: 30005 + $i;
				palfx.time: 1;
				palfx.add: 32,32,32;
				redirectid: map(LeadRTS)}
				map(chosenReinforce) := $i;
				break;
			}
		}
		let a = playerid(map(LeadRTS)),var(10101 + map(chosenReinforce) * 2 + playerid(map(LeadRTS)),map(reinforcepage) * 10);
		if inputtime(b) = 1 && inputtime(x) < 0 && inputtime(z) < 0 && map(chosenReinforce) > -1 && numhelper(1) < 50 && $a > 0 && numhelper(10000)
		{
			helper(10000),map(UnitID) := playerid(map(LeadRTS)),explodvar(30005 + map(chosenReinforce), 0, anim);
			helper(10000),map(moveaction) := 1;
			helper(10000),map(movepointx) := helper(10000),pos x + helper(10000),camerapos x + randomrange(-90,90);
			Helper{
			helpertype: player ;
			id: 1;
			stateno: 5900;
			pos: 0,0 ;
			postype: p1 ;
			facing: 1 ;
			keyctrl: 0 ;
			ownpal: 1 ;
			standby: 0;
			extendsmap: 1;
			redirectid: helper(10000),id}
			playerid(map(LeadRTS)),var(10101 + map(chosenReinforce) * 2 + playerid(map(LeadRTS)),map(reinforcepage) * 10) := $a - 1;
			#playerid(map(LeadRTS)),var(10101 + map(chosenReinforce) * 2 + map(reinforcepage) * 10) := $a - 1;  Possible "Shared" method for later
			helper(10000),map(moveaction) := 0;
			helper(10000),map(movepointx) := 0;
			helper(10000),map(UnitID) := 0;
		}
		if inputtime(b) >= 1 && inputtime(x) < 0 && inputtime(z) < 0 && map(chosenReinforce) < 0
		{
			TagIn{}
			Call Clsn2(0,-1,-1,1,1);
			for i = 0; Numplayer - 1; 1
			{
				if playerindexexist($i) && playerindex($i),ishelper && playerindex($i),id != ID
				{
					if playerindex($i),teamside = teamside && playerindex($i),root,ID = ID
					{
						if !playerindex($i),standby && clsnoverlap(clsn2, playerindex($i),ID, clsn2)
						{
							map(gotone) := 1;
							if map(teamchosen)
							{
								map(chosenUnit) := playerindex($i),ID;
							}
							else
							{
								map(chosenUnit) := playerindex($i),ID;
							}
							break;
						}
					}
				}
			}
		}
		if map(chosenUnit)
		{
			for i = 0; 9; 1
			{
				let b = map(teamchosen);
				if var(10000 + $i + $b * 10) = map(chosenUnit)
				{
					map(chosenUnit) := 0;
					break;
				}
				else
				{
					if var(10000 + $i + $b * 10) != 0
					{
						continue;
					}
					else
					{
						var(10000 + $i + $b * 10) := map(chosenUnit);
						break;
					}
					map(chosenUnit) := 0;
				}
			}
		}
		if inputtime(c) = 1 && inputtime(x) < 0 && inputtime(z) < 0
		{
			if !map(gotone) || inputtime(c) > 0
			{
				for i = 0; 9; 1
				{
					let b = map(teamchosen);
					var(10000 + $i + $b * 10) := map(chosenUnit);
				}
			}
			map(gotone) := 0;
		}
		map(gotone) := 0;
		map(chosenUnit) := 0;
		if inputtime(a) = 1 && inputtime(x) < 0 && inputtime(z) < 0
		{
			let a = playeridexist(map(chosenUnit));
			let b = map(teamchosen);
			ignorehitpause
			{
				for i = 0; 9; 1
				{
					let a = var(10000 + $i + $b * 10);
					if playeridexist($a)
					{
						if playerid($a),alive && playerid($a),ctrl
						{
							if !playerid($a),map(movetime)
							{
								playerid($a),map(movetime) := randomrange(0,8 * $i);
							}
							else
							{
								playerid($a),map(movetime) := 0;
							}
							playerid($a),map(moveaction) := 1;
							playerid($a),map(movepointx) := pos x + camerapos x + randomrange(-10 * $i,10 * $i);
							playerid($a),map(movepointy) := pos y + groundlevel;
						}
					}
					else
					{
						continue;
					}
				}
			}
		}
		if inputtime(a) = 1 && inputtime(x) > 0
		{
			let a = map(teamchosen);
			ignorehitpause
			{
				for i = 0; 9; 1
				{
					let b = var(10000 + $i + $a * 10);
					let c = playeridexist($b);
					if playeridexist($b)
					{
						if playerid($b),alive && playerid($b),ctrl
						{
							playerid($b),map(attackaction) := 1;
							playerid($b),map(attackpointx) := pos x + camerapos x + randomrange(-10,30) * playerid($b),facing;
							playerid($b),map(attackpointy) := pos y + groundlevel;
						}
					}
					else
					{
						continue;
					}
				}
			}
		}
		map(teamchosen) := map(teamchosen) + (inputtime(z) >= 1 && inputtime(c) = 1) - (inputtime(z) >= 1 && inputtime(b) = 1);
		if map(teamchosen) < 0
		{
			map(teamchosen) := 0;
		}
		map(reinforcepage) := map(reinforcepage) + (inputtime(x) >= 1 && inputtime(c) = 1) - (inputtime(x) >= 1 && inputtime(b) = 1);
		if map(reinforcepage) < 0
		{
			map(reinforcepage) := 0;
		}
		#Free up slots between group 0 (no group) to group 9 (ten slots for each group)
		for i = 0; 99; 1
		{
			let a = var(10000 + $i);
			if !playeridexist($a) || playeridexist($a) && !playerid($a),ishelper
			{
				var(10000 + $i) := 0;
			}
		}
	}
	else
	{
		screenbound{}
		if facing != 1
		{
			turn{}
		}
	}
}
if ishelper(10000)
{
	posset{y: 0}
	sprpriority{value: -1}
	if map(BuildID) = 1 && anim != [4,5]
	{
		changeanim{value: MISC5}
	}
}

Call RebelInfantry();
Call AllProjectile();

[StateDef 10;]

Call RebelInfantry();

[StateDef 20;]

Call RebelInfantry();

[StateDef 40;]

Call RebelInfantry();

[StateDef 50;]

Call RebelInfantry();

[StateDef 52;]

Call RebelInfantry();

# Lose
[StateDef 170; ctrl: 0;]

Call RebelInfantry();

# Draw game
[StateDef 175; ctrl: 0;]

Call RebelInfantry();

[StateDef 200;]

Call RebelInfantry();

[StateDef 210;]

Call RebelInfantry();

[StateDef 5150;]

Call RebelInfantry();

[StateDef +1;]

DisplayToClipBoard{text: "%v";
		params: sprpriority}
if !ishelper
{
	let b = map(teamchosen);
	DisplayToClipBoard{text: "%v %v %v %v %v %v %v %v %v %v";
		params: var(10000 + $b * 10),
			var(10001 + $b * 10),
			var(10002 + $b * 10),
			var(10003 + $b * 10),
			var(10004 + $b * 10),
			var(10005 + $b * 10),
			var(10006 + $b * 10),
			var(10007 + $b * 10),
			var(10008 + $b * 10),
			var(10009 + $b * 10),}
	if !ishelper && numexplod(30005)
	{
		let a = explodvar(30004, 0, pos x);
		AppendToClipBoard{text: "\n%v %v %v %v %v";
		params: explodvar(30005, 0, anim),
		(explodvar(30004, 0, pos x)),
		explodvar(30004, 0, pos y),
		#pos x + camerapos x,
		screenpos x,
		#pos y + groundlevel}
		screenpos y}
		if camerapos x + screenpos x = [abs($a + 160), abs($a + 160) + 14]
		{
			
		}
	}
}

[StateDef -4;]

assertspecial{flag: nohardcodedkeys;
flag2: nostandguard;
flag3: noairguard;
flag4: nocrouchguard;
flag5: sizepushonly;
flag6: noautoturn;
flag7: NoFallDefenceUp;
flag8: nobardisplay}

if !ishelper
{
	if !map(LeadRTS) || !playeridexist(map(LeadRTS))
	{
		map(a) := 0;
		for i = 0; numplayer - 1; 1
		{
			if playerindexexist($i) && playerindex($i),teamside = teamside && !playerindex($i),ishelper
			{
				if !map(LeadRTS)
				{
					map(LeadRTS) := playerindex($i),id;
				}
				playerindex($i),map(RTSMemberNo) := map(a) + 1;
				map(a) := map(a) + 1;
			}
		}
	}
}

if map(UnitID) > 0
{
	for i = 0; 9; 1
	{
		let c = root,map(teamchosen);
		let d = root,var(10000 + $i + $c * 10);
		let e = (ID = $d && alive);
		sprpriority{value: 1 + 9 * ($e) }
		if $e
		{
			break;
		}
	}
}